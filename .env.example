# Etiquetta configuration.
#
# Copy to `.env` (same directory you run `etiquetta` from) and uncomment what you
# need. Etiquetta loads `.env` on startup. A real environment variable always
# wins over the file, so `ETIQUETTA_STORAGE=duckdb etiquetta serve` overrides the
# value here. Point at a different file with ETIQUETTA_ENV_FILE=/path/to/file.
#
# All values below are the built-in defaults — leaving a line commented keeps it.

# --- Core ---------------------------------------------------------------------

# HTTP port. A bare number is fine ("3456") or a full listen address (":3456").
#ETIQUETTA_PORT=3456

# Directory for the database, GeoIP db, replays, and buffer temp files.
#ETIQUETTA_DATA_DIR=./data

# Set true when browsers reach Etiquetta over HTTPS (including behind a reverse
# proxy that terminates TLS). Marks the session cookie Secure.
#ETIQUETTA_SECURE_COOKIES=false

# --- Storage ------------------------------------------------------------------

# Storage backend. Default: ducklake — event tables (events, performance,
# errors) live in a DuckLake catalog under {DATA_DIR}/lake (Parquet + snapshots
# + time-travel); metadata stays in the DuckDB file. Set to `duckdb` to keep
# everything in the single DuckDB file instead.
#
# Enabling ducklake on an existing duckdb install is a safe one-way migration:
# the DuckDB file is snapshotted to etiquetta.duckdb.pre-ducklake first.
# The ducklake/httpfs/icu extensions install on first run and need network then.
#ETIQUETTA_STORAGE=ducklake

# --- Write buffer -------------------------------------------------------------

# Rows buffered before a flush.
#ETIQUETTA_BUFFER_THRESHOLD=50000

# Max time between flushes (Go duration: 30s, 1m, ...).
#ETIQUETTA_BUFFER_TIMEOUT=30s

# Where parquet files are staged before load. Defaults to {DATA_DIR}/buffer_tmp.
#ETIQUETTA_BUFFER_TEMP_DIR=./data/buffer_tmp

# --- Dashboards ---------------------------------------------------------------

# Serve dashboard stats from pre-aggregated daily rollup tables. Faster on large
# datasets; leave off unless you need it.
#ETIQUETTA_USE_ROLLUPS=false

# --- Security -----------------------------------------------------------------

# Allow alert webhooks to target private / internal IPs (loopback, RFC1918,
# CGNAT). Off by default because a webhook URL is otherwise an admin-reachable
# SSRF into the host network. Turn on only if you send to an internal service
# (e.g. a local ntfy or Slack proxy).
#ETIQUETTA_ALLOW_PRIVATE_WEBHOOKS=false
